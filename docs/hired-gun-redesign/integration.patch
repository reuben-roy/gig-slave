+
+/* ---- buttons ---- */
+.btn {
+  display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
+  min-height: 2.75rem; padding: 0.55rem 1.1rem;
+  font: inherit; font-weight: 650; font-size: 0.95rem; line-height: 1.2; white-space: nowrap;
