{
  "name": "gigagent",
  "version": "0.2.0",
  "description": "GigAgent: type a code and a trusted helper does one job on your Mac, then removes itself.",
  "type": "module",
  "bin": {
    "gigagent": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepublishOnly": "npm run build",
    "postbuild": "chmod +x dist/bin.js dist/index.js"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-tui": "0.73.1",
    "typebox": "^1.1.24"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "license": "MIT"
}
