{
  "name": "gig-slave",
  "version": "0.1.0",
  "description": "One-command remote helper: type a code, a helper agent does the task on your Mac, then removes itself.",
  "type": "module",
  "bin": {
    "gig-slave": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepublishOnly": "npm run build",
    "postbuild": "chmod +x dist/index.js"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-tui": "0.73.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "license": "MIT"
}
