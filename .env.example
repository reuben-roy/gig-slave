# Copy to .env at the repo root and fill in.
PORT=8787
ADMIN_TOKEN=change-me-to-a-long-random-string
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=sk-...
DEFAULT_MODEL=deepseek-flash
MODELS=deepseek-flash,deepseek-v4-pro
# Merged into every upstream request. DeepSeek thinking mode breaks multi-turn tool calls unless
# reasoning_content is echoed back, so keep it off.
UPSTREAM_EXTRA_BODY={"thinking":{"type":"disabled"}}
# Your Cloudflare tunnel URL (no trailing slash). The CLI is told to call <PUBLIC_URL>/v1.
PUBLIC_URL=https://REPLACE-ME.trycloudflare.com
DB_PATH=./data/gig-slave.db
