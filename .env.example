# Copy to .env at the repo root (local) or set these in the Vercel project (Settings -> Environment Variables).
PORT=8787
ADMIN_TOKEN=change-me-to-a-long-random-string
# Where the CLI is told to call (no trailing slash). On Vercel this defaults to https://$VERCEL_PROJECT_PRODUCTION_URL.
PUBLIC_URL=http://localhost:8787

# Database: Postgres (Neon) when DATABASE_URL is set, otherwise embedded PGlite at PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./data/pglite
# PGLITE_DIR=memory://

# Models. An id containing "/" goes through the Vercel AI Gateway; a bare id goes to UPSTREAM_*.
MODELS=anthropic/claude-haiku-5.5,anthropic/claude-sonnet-5.5,openai/gpt-5.6-luna,deepseek/deepseek-v4.1-flash
DEFAULT_MODEL=anthropic/claude-haiku-5.5
# AI Gateway. On Vercel you can leave the key empty and the server uses the project's OIDC token.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Optional JSON object merged into every gateway request.
GATEWAY_EXTRA_BODY=
# Direct upstream (bare model ids such as deepseek-flash, deepseek-v4-pro; add them to MODELS to enable).
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=
# DeepSeek thinking mode breaks multi-turn tool calls unless reasoning_content is echoed back, so keep it off.
UPSTREAM_EXTRA_BODY={"thinking":{"type":"disabled"}}

# Notifications (optional). Email needs a Resend key; webhooks need nothing.
RESEND_API_KEY=
NOTIFY_FROM=Hired Gun <onboarding@resend.dev>

# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/sweep.
CRON_SECRET=
